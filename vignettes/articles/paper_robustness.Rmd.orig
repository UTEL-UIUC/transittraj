       height = 240, width = 190, units = "mm", scale = 1.2,
       filename = "C:\\Users\\obrie\\OneDrive - University of Illinois - Urbana\\IndyGo Project\\Deliverables\\Papers\\JPT\\images\\figure_11.pdf", device = cairo_pdf)

suppressWarnings(
  pdftools::pdf_convert(
    pdf = "C:\\Users\\obrie\\OneDrive - University of Illinois - Urbana\\IndyGo Project\\Deliverables\\Papers\\JPT\\images\\figure_11.pdf",
    filenames = "figures/paper/figure_11.png",
