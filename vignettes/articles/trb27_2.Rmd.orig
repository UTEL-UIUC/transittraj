       height = 5, width = 8, scale = 0.8, device = svg)
ggsave(plot = step4_plot,
       filename = "C:\\Users\\obrie\\OneDrive - University of Illinois - Urbana\\IndyGo Project\\Deliverables\\Conferences\\TC2026\\Figures\\step4_plot_lowres.png",
       height = 5, width = 8, dpi = 300, scale = 0.8)
