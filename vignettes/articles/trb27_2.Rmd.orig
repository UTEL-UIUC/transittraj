``` {r}
time_int <- 0.1
plot_sig <- "Virginia & South/East"
# sig_bounds <- sig_bnds %>%
#   filter(name == plot_sig) %>%
#   pull(distance)
sig_bounds <- signal_boundings %>%
  filter(name == plot_sig) %>%
  pull(distance)
plot_lims <- c(sig_bounds[1] - 25,
               sig_bounds[2] + 25)
stopbars_filt <- signals %>%
  filter(routes == "90N") %>%
  filter(distance > plot_lims[1] &
           distance < plot_lims[2])

# one-stop plot
plot_trip <- "2024-11-18-t7E5-b233E-sl3-N"

dist_df <- predict(object = traj,
                   distance_lims = plot_lims,
                   timestep = time_int,
                   trip = plot_trip) %>%
  rename(distance = interp) %>%
  select(-deriv)
plot_df <- predict(object = traj,
                   new_times = dist_df,
                   deriv = 1) %>%
  rename(speed = interp) %>%
  mutate(event_timestamp = as.POSIXct(event_timestamp, tz = "America/New_York"))
stop_df <- trip_events %>%
  ungroup() %>%
  filter((trip_id_performed == plot_trip) & (is_stopped == 1) & (name == plot_sig)) %>%
  select(trip_id_performed, name, time_begin, time_end, time_elapsed) %>%
  left_join(y = sig_delay %>% select(trip_id_performed, name, delay, travel_time),
            by = c("trip_id_performed", "name")) %>%
  mutate(time_elapsed = round(time_elapsed, 1),
         delay = round(delay, 1),
         travel_time = round(travel_time, 1),
         lab = paste("Stop\n",
                     "Duration: ", time_elapsed, " s\n",
                     "Total travel time: ", travel_time, " s",
                     sep = ""),
         x = (time_begin + time_end) / 2,
         y = sig_bounds[2] - 40)

aog_plot <- ggplot() +
  geom_hline(aes(yintercept = sig_bounds, linetype = "Entrance/Exit"),
             color = "grey50", linewidth = 0.6) +
  geom_hline(data = stopbars_filt,
             aes(yintercept = distance, linetype = "Stopbar"),
             linewidth = 0.8, color = "grey50") +
  geom_vline(data = stop_df,
             aes(xintercept = time_begin),
             color = "firebrick", linewidth = 1, linetype = "dotdash") +
  geom_vline(data = stop_df,
             aes(xintercept = time_end),
             color = "firebrick", linewidth = 1, linetype = "dotdash") +
  geom_line(data = plot_df,
            aes(x = event_timestamp, y = distance, color = speed),
            linewidth = 3) +
  geom_segment(data = stop_df,
               aes(x = time_begin, xend = time_end,
                   y = y + 15, yend = y + 15),
               arrow = arrow(ends = "both", type = "closed", length = unit(0.025, units = "npc")),
               color = "firebrick", linetype = "solid", linewidth = 0.7) +
  # geom_marquee(data = stop_df,
  #              aes(x = x, y = y - 3, label = lab),
  #              hjust = 0.5, size = 2.8, color = "firebrick", fill = "#FFFFFFE6",
  #              style = lab_firebrick, family = "Verdana") +
  geom_label(data = stop_df,
               aes(x = x, y = y + 15, label = lab),
               hjust = 0.5, size = 2.8,
             color = "firebrick", fill = "white", alpha = 0.9) +
  scale_linetype_manual(name = "Signal",
                        values = c("Entrance/Exit" = "longdash",
                                   "Stopbar" = "dotted")) +
  scale_color_viridis_c(name = "Speed (m/s)",
                        limits = c(0, 15)) +
  scale_x_datetime(date_labels = "%H:%M:%S") +
  scale_y_continuous(name = NULL, labels =  NULL,
                     limits = plot_lims) +
  theme_minimal() +
  labs(x = "Time",
       title = "(b) Stopped Trip",
       subtitle = paste("Trip ID ", plot_trip,
                        sep = "")) +
  theme(text = element_text(family = "Verdana"),
        legend.key.width = unit(2, "line"))
