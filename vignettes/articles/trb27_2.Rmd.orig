                           correct_speed = TRUE,
                           add_distance_error = dist_error)
t_f <- Sys.time()

# Save changes
dur <- append(dur,
              as.numeric(difftime(t_f, t_0, units = "secs")))
n_obs <- append(n_obs,
                dim(step7_df)[1])
n_trips <- append(n_trips,
                  length(unique(step7_df$trip_id_performed)))

rm(step6_df)
gc()
