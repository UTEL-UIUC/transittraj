                     # duration = 3, fps = 3,
                     duration = 30, fps = 30,
                     height = 1280, width = 720, units = "px", scaling = 2.5,
                     renderer = gganimate::av_renderer(),
                     device = "ragg_png")

av::av_video_images(video = "C:/Users/obrie/OneDrive - University of Illinois - Urbana/IndyGo Project/Deliverables/Papers/JPT/videos/video_1.mp4",
                    destdir = "C:/Users/obrie/OneDrive - University of Illinois - Urbana/IndyGo Project/Deliverables/Papers/JPT/videos/video_1_thumbnail.",
                    format = "png",
                    trim = "3:4")
